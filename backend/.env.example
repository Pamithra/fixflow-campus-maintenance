# ==============================================================================
# Optional: Real Phone SMS Gateway Providers
# If left blank, the system simulates SMS and delivers via in-app notification center.
# ==============================================================================

# Option 1: Twilio (Global SMS)
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# Option 2: Notify.lk (Sri Lanka SMS Gateway for +94 numbers)
# NOTIFYLK_USER_ID=your_user_id
# NOTIFYLK_API_KEY=your_api_key
# NOTIFYLK_SENDER_ID=NotifyDEMO
